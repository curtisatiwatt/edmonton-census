    <Folder>
      <name>Public Engagement</name>
    </Folder>
    <Folder>
      <name>Proposed Changes to Valley Line West’s Concept Plan</name>
      <Placemark>
        <name>Lewis Farms LRT terminus site</name>
        <description><![CDATA[Adjusting the location of LRT Stop and LRV storage facility and increasing the size of Park and Ride facility.<br><br>https://www.edmonton.ca/documents/PDF/LewisFarmsValleyLineWest.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.6641002,53.5231278,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>87 Avenue and 178 Street</name>
        <description><![CDATA[Adding an elevated LRT guideway over 178 Street along the south side of 87 Avenue.<br><br>https://www.edmonton.ca/documents/PDF/ValleyLineWest178StreetUpdate.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.6303902,53.5212781,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Jasper Place Transit Centre</name>
        <description>Maintaining the existing location.</description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.5919219,53.5407409,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>156 Street and Stony Plain Road</name>
        <description><![CDATA[Realigning the LRT track and relocating the 156 Street LRT Stop between Stony Plain Road/155 Street and 99 Avenue/156 Street intersections.<br><br>https://www.edmonton.ca/documents/PDF/ValleyLineWest156StreetUpdate.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.5903502,53.5413275,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Stony Plain Road and 149 Street </name>
        <description><![CDATA[Adding an urban interchange separating centre-running at-grade LRT on Stony Plain Road from 149 Street north-south traffic.<br><br>https://www.edmonton.ca/documents/PDF/ValleyLineWest149StreetUpdate.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.5780334,53.5417355,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>124 Street Stop</name>
        <description><![CDATA[Relocating the stop one block east, centred on 123 Street.<br><br>https://www.edmonton.ca/documents/PDF/ValleyLineWest124StreetUpdate.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.535955,53.5472691,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>LRT sidetrack</name>
        <description><![CDATA[Relocating the LRT sidetrack to the median of 104 Avenue, between 109 and 111 Street.<br><br>https://www.edmonton.ca/documents/PDF/ValleyLineWest104AvenueUpdate.pdf]]></description>
        <styleUrl>#icon-1608-A52714</styleUrl>
        <Point>
          <coordinates>
            -113.5103023,53.5462874,0
          </coordinates>
        </Point>
      </Placemark>
