      <Placemark>
        <name>Design Phase - 132 Avenue Station</name>
        <description>The LRT continues north along 113A Street until it reaches 132 Avenue Station. The station is a split-platform configuration where the platforms are located on opposite sides of the intersection. This station will service Rosslyn School, the Canadian Islamic Centre as well as the adjacent mature neighbourhoods</description>
        <styleUrl>#icon-1499-000000</styleUrl>
        <Point>
          <coordinates>
